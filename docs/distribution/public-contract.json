{
  "schemaVersion": 1,
  "product": "UI Torture Lab",
  "distributionStatus": "pre-release",
  "repository": "https://github.com/marlenesco/ui-torture-lab",
  "siteOrigin": "https://ui-torture-lab.pages.dev",
  "storeListing": null,
  "browser": "Google Chrome desktop stable",
  "validatedMinimumChrome": "155",
  "manifestVersion": 3,
  "incognito": "not_allowed",
  "permissions": ["activeTab", "scripting", "storage"],
  "executionWorld": "ISOLATED",
  "mainFrameOnly": true,
  "protocols": ["http:", "https:"],
  "scenarios": ["Long Text", "Unbreakable Text", "Large Text"],
  "detectors": ["Text Clipping", "Horizontal Containment Overflow", "Viewport Overflow"],
  "retention": { "area": "session", "resultsPerTab": 1, "history": false, "tabCloseDeletes": true },
  "export": { "format": "Markdown", "gestureRequired": true, "previewEqualsPayload": true },
  "runNetwork": false,
  "automaticScreenshots": false,
  "fullTextSerialization": false,
  "price": "free",
  "accountRequired": false,
  "featureGates": false,
  "license": "Apache-2.0",
  "support": "best-effort"
}
