{
  "name": "ui-torture-lab",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.13.1 <25",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:extension": "pnpm --filter @ui-torture-lab/extension dev",
    "dev:fixtures": "node tests/fixtures/server.mjs",
    "dev:site": "pnpm --filter @ui-torture-lab/site dev",
    "lint": "eslint .",
    "test": "pnpm build && pnpm test:contracts && pnpm test:e2e",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "puppeteer-core": "25.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
